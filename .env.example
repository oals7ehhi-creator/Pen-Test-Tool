# Pen-Test-Tool — example environment (Phase 1)
# Copy to `.env` and fill in locally. This file contains NO real secrets and is the only env file committed.
# The app validates this config at startup and refuses to boot on missing/invalid required values.

# --- runtime ---
NODE_ENV=development

# --- API service ---
# Bind to loopback by default: the dev stack is NOT exposed on a public interface (Phase 1 safety gate).
API_HOST=127.0.0.1
API_PORT=8080

# --- logging ---
# One of: trace|debug|info|warn|error. Structured JSON is always emitted; only minimized, allowlisted scalar
# context is logged (never tokens, headers, URLs, bodies, cookies, or Authorization values).
LOG_LEVEL=info

# --- authentication ---
# Protected routes trust identity ONLY from a cryptographically verified session token (HS256, signed with the
# resolved signing key). No header/query/body can set a role. `iss`/`aud` are pinned and must match exactly.
AUTH_ISSUER=pentest-tool
AUTH_AUDIENCE=pentest-api

# --- development-only token minter (NOT a role header; NEVER available in production) ---
# When 'true' AND NODE_ENV is not 'production', a dev-only endpoint (POST /dev/token) may MINT a properly signed,
# short-lived session so the auth flow is demonstrable locally. It only issues a signed token — it is not an
# authorization path. Force-disabled and structurally unavailable (404) in production. Leave off unless needed.
DEV_TOKEN_MINTER=false

# --- database (matches docker-compose.yml defaults for local dev only) ---
DATABASE_URL=postgresql://pentest:pentest_dev_only@127.0.0.1:5432/pentest

# --- signing key: a REFERENCE, never the raw key material ---
# SESSION_SIGNING_KEY_REF names the signing key (e.g. an entry in a secret manager). It is NEVER used as the key
# itself; the key provider resolves it to material. A minimum length is enforced so a blank/short value fails
# closed at boot.
SESSION_SIGNING_KEY_REF=dev-insecure-session-key-change-me-0123456789
#
# SESSION_SIGNING_KEY_MATERIAL is the RESOLVED key material for the reference above. It is intentionally left
# UNSET here:
#   - development / test: leave it unset — the key provider uses a process-random EPHEMERAL key so the stack stays
#     usable with no secret on disk (tokens simply do not survive a restart).
#   - production: it MUST resolve to strong material (>= 32 bytes) from your secret manager / orchestrator, injected
#     at runtime and NEVER committed to a repository or image. The API FAILS CLOSED (refuses to boot) if it is
#     missing or weak. Do not put real key material in this file.
# SESSION_SIGNING_KEY_MATERIAL=
