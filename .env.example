# Pen-Test-Tool — example environment (Phase 1)
# Copy to `.env` and fill in locally. This file contains NO real secrets and is the only env file committed.
# The app validates this config at startup and refuses to boot on missing/invalid required values.

# --- runtime ---
NODE_ENV=development

# --- API service ---
# Bind to loopback by default: the dev stack is NOT exposed on a public interface (Phase 1 safety gate).
API_HOST=127.0.0.1
API_PORT=8080

# --- logging ---
# One of: trace|debug|info|warn|error. Structured JSON is always emitted; secrets are redacted before any sink.
LOG_LEVEL=info

# --- database (matches docker-compose.yml defaults for local dev only) ---
DATABASE_URL=postgresql://pentest:pentest_dev_only@127.0.0.1:5432/pentest

# --- secrets: references only, never the secret material itself ---
# In real deployments these name entries in the secret manager. Placeholders here are non-secret and dev-only.
# A minimum length is enforced so a blank/short value fails closed at boot.
SESSION_SIGNING_KEY_REF=dev-insecure-session-key-change-me-0123456789
